{
  "name": "@trapezium/vanilla",
  "version": "0.1.0",
  "description": "A data table for plain JavaScript: zero-config columns, filtering, search, pagination and selection, with no framework and no dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gregaly/trapezium.git",
    "directory": "packages/vanilla"
  },
  "homepage": "https://github.com/Gregaly/trapezium#readme",
  "keywords": [
    "table",
    "data-table",
    "datagrid",
    "vanilla",
    "javascript",
    "web"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "themes",
    "LICENSE",
    "llms.txt",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./themes/shadcn.css": "./themes/shadcn.css",
    "./themes/shadcn-hsl.css": "./themes/shadcn-hsl.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-styles.mjs vanilla",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@trapezium/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "name": "@trapezium/vue",
  "version": "0.1.0",
  "description": "A data table for Vue 3 that looks right out of the box: zero-config columns, filtering, search, pagination, selection and custom renderers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gregaly/trapezium.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/Gregaly/trapezium#readme",
  "keywords": ["vue", "nuxt", "table", "data-table", "datagrid"],
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "styles.css", "themes"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./themes/shadcn.css": "./themes/shadcn.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-styles.mjs vue",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@trapezium/core": "workspace:*",
    "@trapezium/vanilla": "workspace:*"
  },
  "peerDependencies": { "vue": "^3.4.0" },
  "devDependencies": { "vue": "^3.5.0" },
  "publishConfig": { "access": "public" }
}
